    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.7.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.4.3",
