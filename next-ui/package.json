    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/runner": "^4.0.0",
    "allure-vitest": "^3.0.0",
    "eslint": "^9",
